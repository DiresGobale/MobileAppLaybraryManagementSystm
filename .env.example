# Server
PORT=4000
NODE_ENV=development

# Database (better-sqlite3 file path; absolute or relative to project root)
# Production: switch to PostgreSQL by setting DATABASE_URL=postgres://user:pass@host:5432/iulms
DATABASE_PATH=./data/iulms.db

# JWT
JWT_SECRET=replace-me-with-a-long-random-string-in-production-min-32-chars
JWT_EXPIRES_IN=7d
JWT_ISSUER=iulms-backend

# CORS — comma-separated list of allowed origins.
# For the Flutter app running on Android emulators, use http://10.0.2.2:4000
# For web dev, use http://localhost:5173 (Vite) or your dev URL.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080,http://10.0.2.2:4000,https://preview-iulms.space-z.ai

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# Default admin (only used by `npm run seed` if no admin exists yet)
DEFAULT_ADMIN_FULL_NAME=Selam Bekele
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_EMAIL=admin@injibara.edu
DEFAULT_ADMIN_PASSWORD=ChangeMe!2025

# Logging
LOG_LEVEL=info
