{
  "name": "iulms-backend",
  "version": "1.0.0",
  "description": "Node.js + Express backend for the Injibara University Library Management System (IULMS). Provides JWT authentication, role-based access control, transactional loan workflows, activity logging, CSV reports, and a complete REST API consumed by the Flutter mobile app.",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon --watch src src/server.js",
    "migrate": "node src/db/migrate.js",
    "seed": "node src/db/seed.js",
    "setup": "npm run migrate && npm run seed",
    "test": "jest --runInBand --testTimeout=10000",
    "test:watch": "jest --watch"
  },
  "keywords": [
    "library",
    "management",
    "nodejs",
    "express",
    "sqlite",
    "jwt",
    "iulms",
    "injibara"
  ],
  "author": "Dires Gobale <dires.gobale@injibara.edu>",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^11.3.0",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "express-validator": "^7.2.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.1.4",
    "supertest": "^7.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
